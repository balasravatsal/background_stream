<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingTop="28dp"
            android:paddingBottom="36dp">

            <!-- Brand -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_brand_orb">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_wave" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:letterSpacing="0.12"
                    android:text="@string/setup_eyebrow"
                    android:textAllCaps="true"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit_semibold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/brand_name"
                android:textAppearance="@style/AppText.Brand" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/setup_subtitle"
                android:textAppearance="@style/AppText.Subtitle" />

            <!-- Status glass card -->
            <LinearLayout
                android:id="@+id/statusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_card_title"
                    android:textAppearance="@style/AppText.Section" />

                <!-- Listener -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/status_line_listener"
                        android:textAppearance="@style/AppText.RowTitle" />

                    <TextView
                        android:id="@+id/badgeListener"
                        style="@style/AppText.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Ready" />
                </LinearLayout>

                <!-- Post notifications -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/status_line_post"
                        android:textAppearance="@style/AppText.RowTitle" />

                    <TextView
                        android:id="@+id/badgePost"
                        style="@style/AppText.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Needed" />
                </LinearLayout>

                <!-- Battery -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/status_line_battery"
                        android:textAppearance="@style/AppText.RowTitle" />

                    <TextView
                        android:id="@+id/badgeBattery"
                        style="@style/AppText.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Ready" />
                </LinearLayout>

                <!-- Tile -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/status_line_tile"
                        android:textAppearance="@style/AppText.RowTitle" />

                    <TextView
                        android:id="@+id/badgeTile"
                        style="@style/AppText.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_missing" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGrantAll"
                style="@style/AppButton.GlassPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/grant_all"
                app:backgroundTint="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/permissions_section"
                android:textAppearance="@style/AppText.Section" />

            <!-- Individual permission glass buttons -->
            <LinearLayout
                android:id="@+id/btnGrantPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_glass_button_secondary"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/grant_notification_access"
                    android:textAppearance="@style/AppText.RowTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/perm_hint_listener"
                    android:textAppearance="@style/AppText.Body" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnPostNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_glass_button_secondary"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/grant_post_notifications"
                    android:textAppearance="@style/AppText.RowTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/perm_hint_post"
                    android:textAppearance="@style/AppText.Body" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnBattery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_glass_button_secondary"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/grant_battery"
                    android:textAppearance="@style/AppText.RowTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/perm_hint_battery"
                    android:textAppearance="@style/AppText.Body" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnAddTile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_glass_button_secondary"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/add_qs_tile"
                    android:textAppearance="@style/AppText.RowTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/perm_hint_tile"
                    android:textAppearance="@style/AppText.Body" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:alpha="0.9"
                android:text="@string/footer_tip"
                android:textAppearance="@style/AppText.Body" />

            <!-- Kept for ViewBinding compatibility if referenced; hidden -->
            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
